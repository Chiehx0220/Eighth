<!doctype html>
<html lang="zh-Hant">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} | {{ site.site_title }}</title>
  <link rel="icon" href="{{ '/assets/icons/favicon.svg' | url }}" type="image/svg+xml">
  <link rel="icon" href="{{ '/assets/icons/favicon-48.png' | url }}" type="image/png">
  <link rel="apple-touch-icon" href="{{ '/assets/icons/apple-touch-icon.png' | url }}">
  <link rel="manifest" href="{{ '/assets/manifest.json' | url }}">
  <meta name="theme-color" content="#0061a4">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="{{ '/assets/css/style.css' | url }}">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=block">
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&display=swap" onload="this.onload=null;this.rel='stylesheet'">
  <noscript>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&display=swap" rel="stylesheet">
  </noscript>
  <script>
    (function () {
      var saved = localStorage.getItem("theme");
      if (saved === "dark" || saved === "light") {
        document.documentElement.setAttribute("data-theme", saved);
      }
    })();
  </script>
</head>
<body>
  <a href="#main-content" class="skip-link" data-i18n="skip">跳到主要內容</a>

  <header class="top-app-bar">
    <div class="top-app-bar__row">
      {% if page.url != "/" %}
      <div class="top-app-bar__leading">
        <button type="button" class="top-app-bar__back" id="page-back" data-fallback="{{ '/' | url }}" aria-label="返回上一頁" data-i18n-aria="back">
          <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
        </button>
        <span class="top-app-bar__title">{{ title }}</span>
      </div>
      {% else %}
      <a href="{{ '/' | url }}" class="brand" data-staff-url="{{ '/beds/' | url }}">
        <span class="brand__icon material-symbols-outlined" aria-hidden="true">local_hospital</span>
        <span class="brand__name">{{ site.site_title }}</span>
      </a>
      {% endif %}

      <div class="a11y-controls">
        {% if page.url != "/" %}
        <a href="{{ '/' | url }}" class="btn btn--tonal" aria-label="回首頁" data-i18n-aria="home">
          <span class="material-symbols-outlined" aria-hidden="true">home</span>
        </a>
        {% endif %}
        <button type="button" id="theme-toggle" class="btn btn--outlined" aria-label="切換日間/夜間模式" data-i18n-aria="theme">
          <span class="material-symbols-outlined" id="theme-toggle-icon" aria-hidden="true">dark_mode</span>
        </button>
        <div class="font-toggle" role="group" aria-label="字體大小" data-i18n-aria="fontGroup">
          <button type="button" id="font-smaller" class="btn btn--outlined" aria-label="縮小字體" data-i18n-aria="fontSmaller">
            <span class="material-symbols-outlined" aria-hidden="true">text_decrease</span>
          </button>
          <button type="button" id="font-larger" class="btn btn--outlined" aria-label="放大字體" data-i18n-aria="fontLarger">
            <span class="material-symbols-outlined" aria-hidden="true">text_increase</span>
          </button>
        </div>
        <select id="lang-select" class="btn btn--outlined lang-select" aria-label="語言" data-i18n-aria="language"></select>
      </div>
    </div>
  </header>

  <main id="main-content" class="page">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <p data-i18n="footerDisclaimer">如頁面資訊與現場公告不一致,請以護理站現場說明為準。</p>
  </footer>

  <script src="{{ '/assets/js/main.js' | url }}"></script>
  <script src="{{ '/assets/js/i18n.js' | url }}"></script>
</body>
</html>
