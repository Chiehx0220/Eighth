<!doctype html>
<html lang="zh-Hant">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} | {{ site.site_title }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=block" rel="stylesheet">
  <link rel="stylesheet" href="{{ '/assets/css/style.css' | url }}">
  <script>
    (function () {
      var saved = localStorage.getItem("theme");
      if (saved === "dark" || saved === "light") {
        document.documentElement.setAttribute("data-theme", saved);
      }
    })();
  </script>
</head>
<body>
  <a href="#main-content" class="skip-link">跳到主要內容</a>

  <header class="top-app-bar">
    <div class="top-app-bar__row">
      {% if page.url != "/" %}
      <button type="button" class="top-app-bar__back" id="page-back" data-fallback="{{ '/' | url }}" aria-label="返回上一頁">
        <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
      </button>
      <span class="top-app-bar__title">{{ title }}</span>
      {% else %}
      <a href="{{ '/' | url }}" class="brand">
        <span class="brand__icon material-symbols-outlined" aria-hidden="true">local_hospital</span>
        <span class="brand__name">{{ site.site_title }}</span>
      </a>
      {% endif %}

      <div class="a11y-controls">
        {% if page.url != "/" %}
        <a href="{{ '/' | url }}" class="btn btn--outlined" aria-label="回首頁">
          <span class="material-symbols-outlined" aria-hidden="true">home</span>
        </a>
        {% endif %}
        <button type="button" id="theme-toggle" class="btn btn--outlined" aria-label="切換日間/夜間模式">
          <span class="material-symbols-outlined" id="theme-toggle-icon" aria-hidden="true">dark_mode</span>
        </button>
        <div class="font-toggle" role="group" aria-label="字體大小">
          <button type="button" id="font-smaller" class="btn btn--outlined" aria-label="縮小字體">
            <span class="material-symbols-outlined" aria-hidden="true">text_decrease</span>
          </button>
          <button type="button" id="font-larger" class="btn btn--outlined" aria-label="放大字體">
            <span class="material-symbols-outlined" aria-hidden="true">text_increase</span>
          </button>
        </div>
      </div>
    </div>
  </header>

  <main id="main-content" class="page">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <p>如頁面資訊與現場公告不一致,請以護理站現場說明為準。</p>
  </footer>

  <script src="{{ '/assets/js/main.js' | url }}"></script>
</body>
</html>
