---
layout: layouts/base.njk
title: "餐飲資訊"
permalink: /dining/
---
<h1>餐飲資訊</h1>

{% for place in dining.list %}
<div class="ward-block">
  <h2>{{ place.name }}</h2>
  <p>位置:{{ place.location }} ・ 營業時間:{{ place.hours }}</p>
  {% if place.note %}<p class="ward-block__note">{{ place.note }}</p>{% endif %}
  {% for group in place.groups %}
  {% if group.name %}<h3>{{ group.name }}</h3>{% endif %}
  {% set hasTime = group.items[0].time %}
  <table class="price-table">
    <thead>
      <tr>
        <th>品項</th>
        {% if hasTime %}<th>供餐時間</th>{% endif %}
        <th>價格</th>
        <th>說明</th>
      </tr>
    </thead>
    <tbody>
      {% for item in group.items %}
      <tr>
        <td data-label="品項">{{ item.name }}</td>
        {% if hasTime %}<td data-label="供餐時間">{{ item.time }}</td>{% endif %}
        <td data-label="價格">NT$ {{ item.price }}</td>
        <td data-label="說明">{{ item.note }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endfor %}
</div>
{% endfor %}
