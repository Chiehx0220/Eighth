---
layout: layouts/base.njk
title: "飲食相關"
permalink: /dining/
---
<h1>飲食相關</h1>

<a href="{{ '/dining/diet-guide/' | url }}" class="content-link-card">
  <span class="content-link-card__icon material-symbols-outlined" aria-hidden="true">restaurant_menu</span>
  <span class="content-link-card__text">
    <span class="content-link-card__title">飲食衛教</span>
    <span class="content-link-card__desc">手術恢復、腸胃檢查、牙口調整——依身體狀況分階段調整的飲食質地說明</span>
  </span>
  <span class="content-link-card__arrow material-symbols-outlined" aria-hidden="true">arrow_forward</span>
</a>

{% set place = dining.mealService %}
<div class="ward-block">
  <h2>{{ place.name }}</h2>
  {% if place.note %}<p class="ward-block__note">{{ place.note }}</p>{% endif %}
  {% for group in place.groups %}
  {% if group.name %}<h3>{{ group.name }}</h3>{% endif %}
  {% set hasTime = group.items[0].time %}
  <table class="price-table">
    <thead>
      <tr>
        <th></th>
        {% if hasTime %}<th>供餐時間</th>{% else %}<th>說明</th>{% endif %}
        <th>價格</th>
      </tr>
    </thead>
    <tbody>
      {% for item in group.items %}
      <tr>
        <td data-label="">{{ item.name }}</td>
        {% if hasTime %}<td data-label="供餐時間">{{ item.time }}</td>{% else %}<td data-label="說明">{{ item.note }}</td>{% endif %}
        <td data-label="價格">NT$ {{ item.price }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endfor %}
</div>

{% if dining.otherShops.list.length %}
<div class="ward-block">
  <h2>{{ dining.otherShops.name }}</h2>
  <ul class="shop-list">
    {% for shop in dining.otherShops.list %}
    <li class="shop-list__item">
      <p class="shop-list__name">{{ shop.name }}</p>
      {% if shop.location %}<p class="shop-list__location">位置:{{ shop.location }}</p>{% endif %}
      <p class="shop-list__sells">{{ shop.sells }}</p>
    </li>
    {% endfor %}
  </ul>
</div>
{% endif %}
