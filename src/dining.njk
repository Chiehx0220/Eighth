---
layout: layouts/base.njk
title: "餐飲資訊"
permalink: /dining/
---
<h1>餐飲資訊</h1>

{% set place = dining.mealService %}
<div class="ward-block">
  <h2>{{ place.name }}</h2>
  <p>位置:{{ place.location }}</p>
  {% if place.note %}<p class="ward-block__note">{{ place.note }}</p>{% endif %}
  {% for group in place.groups %}
  {% if group.name %}<h3>{{ group.name }}</h3>{% endif %}
  {% set hasTime = group.items[0].time %}
  <table class="price-table">
    <thead>
      <tr>
        <th></th>
        {% if hasTime %}<th>供餐時間</th>{% else %}<th>說明</th>{% endif %}
        <th>價格</th>
      </tr>
    </thead>
    <tbody>
      {% for item in group.items %}
      <tr>
        <td data-label="">{{ item.name }}</td>
        {% if hasTime %}<td data-label="供餐時間">{{ item.time }}</td>{% else %}<td data-label="說明">{{ item.note }}</td>{% endif %}
        <td data-label="價格">NT$ {{ item.price }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endfor %}
</div>

{% if dining.otherShops.list.length %}
<div class="ward-block">
  <h2>{{ dining.otherShops.name }}</h2>
  <p>位置:{{ dining.otherShops.location }}</p>
  <ul class="shop-list">
    {% for shop in dining.otherShops.list %}
    <li class="shop-list__item">
      <p class="shop-list__name">{{ shop.name }}</p>
      <p class="shop-list__sells">{{ shop.sells }}</p>
    </li>
    {% endfor %}
  </ul>
</div>
{% endif %}
