---
layout: layouts/base.njk
title: "床位系統"
permalink: /beds/
---
<h1>床位系統</h1>

<div class="staff-gate" id="staff-gate" data-codes="{{ site.staff_access_codes | join(',') }}">
  <span class="staff-gate__icon material-symbols-outlined" aria-hidden="true">admin_panel_settings</span>
  <h2 class="staff-gate__title">員工登入</h2>
  <p class="staff-gate__body">請輸入員工號以查看目前床位狀態。</p>
  <div class="m3-field">
    <label for="staff-gate-input">員工號</label>
    <input type="text" id="staff-gate-input" class="m3-field__input" inputmode="numeric" autocomplete="off">
  </div>
  <p class="staff-gate__error" id="staff-gate-error" hidden>員工號錯誤,請重新輸入。</p>
  <button type="button" class="btn btn--filled staff-gate__submit" id="staff-gate-submit">
    確認
    <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
  </button>
</div>

<div id="staff-content" hidden>
  <table class="price-table">
    <thead>
      <tr>
        <th>房型</th>
        <th>狀態</th>
        <th>空床號</th>
      </tr>
    </thead>
    <tbody>
      {% set categories = [
        { label: "單人房", beds: rooms.single_room_beds },
        { label: "差價雙人房", beds: rooms.double_room_beds },
        { label: "健保四人房", beds: rooms.insured_quad_room_beds },
        { label: "健保雙人房", beds: rooms.insured_double_room_beds }
      ] %}
      {% for cat in categories %}
      {% set available = cat.beds | availableBeds %}
      <tr>
        <td data-label="房型">{{ cat.label }}</td>
        <td data-label="狀態">
          {% if cat.beds.length == 0 %}
          <span class="m3-chip m3-chip--secondary">尚無床位資料</span>
          {% elif available == 0 %}
          <span class="m3-chip m3-chip--error">客滿(0/{{ cat.beds.length }})</span>
          {% elif available <= 2 %}
          <span class="m3-chip m3-chip--warning">剩 {{ available }}/{{ cat.beds.length }} 床</span>
          {% else %}
          <span class="m3-chip m3-chip--success">剩 {{ available }}/{{ cat.beds.length }} 床</span>
          {% endif %}
        </td>
        <td data-label="空床號" class="price-table__cell--wrap">{{ cat.beds | vacantBedLabels or "-" }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
