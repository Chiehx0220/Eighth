---
layout: layouts/base.njk
title: "床位系統"
permalink: /beds/
---
<h1>床位系統</h1>

<div class="staff-gate" id="staff-gate" data-codes="{{ site.staff_access_codes | join(',') }}">
  <span class="staff-gate__icon material-symbols-outlined" aria-hidden="true">admin_panel_settings</span>
  <h2 class="staff-gate__title">員工登入</h2>
  <p class="staff-gate__body">請輸入員工號以查看目前床位狀態。</p>
  <div class="m3-field">
    <label for="staff-gate-input">員工號</label>
    <input type="text" id="staff-gate-input" class="m3-field__input" inputmode="numeric" autocomplete="off">
  </div>
  <p class="staff-gate__error" id="staff-gate-error" hidden>員工號錯誤,請重新輸入。</p>
  <button type="button" class="btn btn--filled staff-gate__submit" id="staff-gate-submit">
    確認
    <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
  </button>
</div>

<div id="staff-content" hidden>
  <table class="price-table price-table--beds">
    <thead>
      <tr>
        <th>房型</th>
        <th>狀態</th>
        <th>空床號</th>
      </tr>
    </thead>
    <tbody>
      {% set categories = [
        { label: "單人房", beds: rooms.single_room_beds, hasGender: false },
        { label: "差價雙人房", rooms: rooms.double_room_beds, hasGender: true },
        { label: "健保四人房", rooms: rooms.insured_quad_room_beds, hasGender: true },
        { label: "健保雙人房", rooms: rooms.insured_double_room_beds, hasGender: true }
      ] %}
      {% for cat in categories %}
      {% if cat.hasGender %}{% set beds = cat.rooms | flattenRoomBeds %}{% else %}{% set beds = cat.beds %}{% endif %}
      {% set available = beds | availableBeds %}
      <tr>
        <td data-label="房型">{{ cat.label }}</td>
        <td data-label="狀態">
          {% if beds.length == 0 %}
          <span class="m3-chip m3-chip--secondary">尚無床位資料</span>
          {% elif available == 0 %}
          <span class="m3-chip m3-chip--error">客滿(0/{{ beds.length }})</span>
          {% elif available <= 2 %}
          <span class="m3-chip m3-chip--warning">剩 {{ available }}/{{ beds.length }} 床</span>
          {% else %}
          <span class="m3-chip m3-chip--success">剩 {{ available }}/{{ beds.length }} 床</span>
          {% endif %}
        </td>
        <td data-label="空床號" class="price-table__cell--wrap">
          {% if cat.hasGender %}
            {% set maleVacant = cat.rooms | vacantBedLabelsByRoomGender("男") %}
            {% set femaleVacant = cat.rooms | vacantBedLabelsByRoomGender("女") %}
            {% set unsetOccupiedVacant = cat.rooms | vacantBedLabelsRoomsNoGenderOccupied %}
            {% set emptyVacant = cat.rooms | vacantBedLabelsRoomsEmpty %}
            {% if not maleVacant and not femaleVacant and not unsetOccupiedVacant and not emptyVacant %}
            -
            {% else %}
              {% if maleVacant %}<div>男:{{ maleVacant }}</div>{% endif %}
              {% if femaleVacant %}<div>女:{{ femaleVacant }}</div>{% endif %}
              {% if unsetOccupiedVacant %}<div class="vacant-beds__unset">未設性別:{{ unsetOccupiedVacant }}</div>{% endif %}
              {% if emptyVacant %}<div class="vacant-beds__empty">尚未收治(不限性別):{{ emptyVacant }}</div>{% endif %}
            {% endif %}
          {% else %}
            {{ beds | vacantBedLabels or "-" }}
          {% endif %}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <a href="{{ '/admin/#/collections/rooms/entries/rooms' | url }}" class="btn btn--tonal staff-content__edit-btn">
    <span class="material-symbols-outlined" aria-hidden="true">edit</span>
    編輯床位
  </a>

  <h2>候補申請</h2>
  <div id="applications-list" class="applications-list" aria-live="polite">
    <p class="applications-list__status">載入中…</p>
  </div>
</div>

<dialog id="mark-done-dialog" class="m3-dialog">
  <form id="mark-done-form" class="m3-dialog__form" novalidate>
    <h2 class="m3-dialog__title">確認標記已處理</h2>
    <p class="m3-dialog__subtitle" id="mark-done-summary"></p>

    <div class="m3-field">
      <label for="mark-done-input">員工號</label>
      <input type="text" id="mark-done-input" class="m3-field__input" inputmode="numeric" autocomplete="off" required>
    </div>
    <p class="staff-gate__error" id="mark-done-error" hidden>員工號錯誤,請重新輸入。</p>

    <div class="m3-dialog__actions">
      <button type="button" class="btn btn--text" id="mark-done-cancel">取消</button>
      <button type="submit" class="btn btn--filled">確認</button>
    </div>
  </form>
</dialog>
