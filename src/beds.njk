---
layout: layouts/base.njk
title: "床位系統"
permalink: /beds/
---
<h1>床位系統</h1>

<div class="staff-gate" id="staff-gate" data-codes="{{ site.staff_access_codes }}">
  <span class="staff-gate__icon material-symbols-outlined" aria-hidden="true">admin_panel_settings</span>
  <h2 class="staff-gate__title">員工登入</h2>
  <p class="staff-gate__body">請輸入員工號以查看目前床位狀態。</p>
  <div class="m3-field">
    <label for="staff-gate-input">員工號</label>
    <input type="text" id="staff-gate-input" class="m3-field__input" inputmode="numeric" autocomplete="off">
  </div>
  <p class="staff-gate__error" id="staff-gate-error" hidden>員工號錯誤,請重新輸入。</p>
  <button type="button" class="btn btn--filled staff-gate__submit" id="staff-gate-submit">
    確認
    <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
  </button>
</div>

<div id="staff-content" hidden>
  <div id="staff-greeting" class="staff-greeting" hidden>
    <span class="staff-greeting__icon material-symbols-outlined" aria-hidden="true">waving_hand</span>
    <p class="staff-greeting__text">
      <span class="staff-greeting__name" id="staff-greeting-name"></span>
      <span class="staff-greeting__sub">歡迎回來</span>
    </p>
  </div>
  <script type="application/json" id="bed-structure-data">
    {
      "single_room_beds": {{ rooms.single_room_beds | pluckLabel | dump | safe }},
      "double_room_beds": {{ rooms.double_room_beds | pluckRoom | dump | safe }},
      "insured_quad_room_beds": {{ rooms.insured_quad_room_beds | pluckRoom | dump | safe }},
      "insured_double_room_beds": {{ rooms.insured_double_room_beds | pluckRoom | dump | safe }}
    }
  </script>

  <h2>待排單/雙人</h2>
  <div class="applications-groups">
    <div class="applications-group">
      <h3 class="applications-group__title">
        <span class="material-symbols-outlined" aria-hidden="true">bed</span>
        單人房
      </h3>
      <div id="applications-list-single" class="applications-list" aria-live="polite">
        <p class="applications-list__status">載入中…</p>
      </div>
    </div>
    <div class="applications-group">
      <h3 class="applications-group__title">
        <span class="material-symbols-outlined" aria-hidden="true">group</span>
        雙人房
      </h3>
      <div id="applications-list-double" class="applications-list" aria-live="polite">
        <p class="applications-list__status">載入中…</p>
      </div>
    </div>
  </div>

  <div class="bed-status-toolbar">
    <h2>預卡床位</h2>
    <div class="bed-status-toolbar__actions">
      <button type="button" class="btn btn--filled" id="bed-hold-add">
        <span class="material-symbols-outlined" aria-hidden="true">bookmark_add</span>
        新增預卡
      </button>
    </div>
  </div>
  <p class="applications-list__status">給醫師或其他病房單位(如 ICU)預先保留床位。已預卡的床會在下方床位狀態標示,若該床目前仍有病人在住,標示會疊加顯示,不會蓋掉現有占用狀態。</p>
  <div id="bed-holds-list" class="applications-list" aria-live="polite">
    <p class="applications-list__status">載入中…</p>
  </div>

  <div class="bed-status-toolbar">
    <h2>床位狀態</h2>
    <div class="bed-status-toolbar__actions">
      <button type="button" class="btn btn--tonal" id="bed-status-edit">
        <span class="material-symbols-outlined" aria-hidden="true">edit</span>
        編輯床位
      </button>
      <button type="button" class="btn btn--filled" id="bed-status-save" hidden>
        儲存<span id="bed-status-save-count"></span>
      </button>
      <button type="button" class="btn btn--text" id="bed-status-cancel" hidden>取消</button>
    </div>
  </div>
  <p class="applications-list__status" id="bed-status-flash" role="status"></p>

  <div id="bed-status-sections" class="bed-status-sections">
    <p class="applications-list__status">載入中…</p>
  </div>
</div>

<dialog id="mark-done-dialog" class="m3-dialog">
  <form id="mark-done-form" class="m3-dialog__form" novalidate>
    <h2 class="m3-dialog__title">確認已給床</h2>
    <p class="m3-dialog__subtitle" id="mark-done-summary"></p>

    <div class="m3-field">
      <label for="mark-done-input">員工號</label>
      <input type="text" id="mark-done-input" class="m3-field__input" inputmode="numeric" autocomplete="off" required>
    </div>
    <p class="staff-gate__error" id="mark-done-error" hidden>員工號錯誤,請重新輸入。</p>

    <div class="m3-dialog__actions">
      <button type="button" class="btn btn--text" id="mark-done-cancel">取消</button>
      <button type="submit" class="btn btn--filled">確認</button>
    </div>
  </form>
</dialog>

<dialog id="bed-hold-dialog" class="m3-dialog">
  <form id="bed-hold-form" class="m3-dialog__form" novalidate>
    <div class="m3-dialog__header">
      <span class="m3-dialog__icon material-symbols-outlined" aria-hidden="true">bookmark_add</span>
      <h2 class="m3-dialog__title">預卡床位</h2>
    </div>
    <p class="m3-dialog__subtitle">選擇要保留的床位,其餘欄位皆為選填。</p>

    <div class="m3-field">
      <label for="bed-hold-bed">預卡床位</label>
      <select id="bed-hold-bed" name="bed-label" class="m3-field__input" required></select>
    </div>
    <div class="m3-field">
      <label for="bed-hold-patient">病患姓名(選填)</label>
      <input type="text" id="bed-hold-patient" class="m3-field__input" maxlength="50" autocomplete="off">
    </div>
    <div class="m3-field">
      <label for="bed-hold-doctor">主治醫師(選填)</label>
      <input type="text" id="bed-hold-doctor" class="m3-field__input" maxlength="50" autocomplete="off">
    </div>
    <div class="m3-field">
      <label for="bed-hold-unit">轉入單位(選填)</label>
      <input type="text" id="bed-hold-unit" class="m3-field__input" maxlength="50" autocomplete="off" placeholder="例如:ICU">
    </div>
    <div class="m3-field">
      <label for="bed-hold-time">預計入住時間(選填)</label>
      <input type="datetime-local" id="bed-hold-time" class="m3-field__input">
    </div>

    <p class="m3-dialog__status" role="status" hidden>
      <span class="material-symbols-outlined" aria-hidden="true"></span>
      <span class="m3-dialog__status-text"></span>
    </p>

    <div class="m3-dialog__actions">
      <button type="button" class="btn btn--text" id="bed-hold-cancel">取消</button>
      <button type="submit" class="btn btn--filled">
        送出預卡
        <span class="material-symbols-outlined" aria-hidden="true">send</span>
      </button>
    </div>
  </form>
</dialog>

<dialog id="cancel-hold-dialog" class="m3-dialog">
  <form id="cancel-hold-form" class="m3-dialog__form" novalidate>
    <h2 class="m3-dialog__title">取消預卡</h2>
    <p class="m3-dialog__subtitle" id="cancel-hold-summary"></p>

    <div class="m3-field">
      <label for="cancel-hold-input">員工號</label>
      <input type="text" id="cancel-hold-input" class="m3-field__input" inputmode="numeric" autocomplete="off" required>
    </div>
    <p class="staff-gate__error" id="cancel-hold-error" hidden>員工號錯誤,請重新輸入。</p>

    <div class="m3-dialog__actions">
      <button type="button" class="btn btn--text" id="cancel-hold-cancel">取消</button>
      <button type="submit" class="btn btn--filled">確認取消預卡</button>
    </div>
  </form>
</dialog>
