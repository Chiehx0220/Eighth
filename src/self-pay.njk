---
layout: layouts/base.njk
title: "自費項目"
permalink: /self-pay/
---
<h1>自費項目</h1>
{% if selfpay.disclaimer %}
<p class="price-table-disclaimer">{{ selfpay.disclaimer }}</p>
{% endif %}

{% for group in selfpay.groups %}
<h2>{{ group.category }}</h2>
<table class="price-table">
  <thead>
    <tr><th>項目</th><th>價格</th><th>單位</th></tr>
  </thead>
  <tbody>
    {% for item in group.items %}
    <tr>
      <td data-label="項目">{{ item.name }}</td>
      <td data-label="價格">NT$ {{ item.price }}</td>
      <td data-label="單位">{{ item.unit }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% endfor %}
