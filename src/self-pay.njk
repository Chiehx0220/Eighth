---
layout: layouts/base.njk
title: "自費項目"
permalink: /self-pay/
---
<h1>自費項目</h1>
{% if selfpay.disclaimer %}
<p class="price-table-disclaimer">{{ selfpay.disclaimer }}</p>
{% endif %}

<nav class="section-jump" aria-label="快速跳到分類">
  {% for group in selfpay.groups %}
  <a href="#cat-{{ loop.index0 }}" class="m3-chip m3-chip--outline">{{ group.category }}</a>
  {% endfor %}
</nav>

{% for group in selfpay.groups %}
{% set groupIndex = loop.index0 %}
<section class="price-section" id="cat-{{ groupIndex }}">
  <div class="price-section__head">
    {% if group.icon %}
    <span class="price-section__icon material-symbols-outlined" aria-hidden="true">{{ group.icon }}</span>
    {% endif %}
    <h2 class="price-section__title">{{ group.category }}</h2>
  </div>
  <table class="price-table">
    <thead>
      <tr><th>項目</th><th class="price-table__price-col">價格</th><th>單位</th></tr>
    </thead>
    <tbody>
      {% for item in group.items %}
      <tr>
        <td data-label="項目">
          {{ item.name }}
          {% if item.images and item.images.length %}
          <button type="button" class="price-table__image-btn" data-name="{{ item.name }}" data-target="item-images-{{ groupIndex }}-{{ loop.index0 }}" aria-label="查看「{{ item.name }}」參考圖片">
            <span class="material-symbols-outlined" aria-hidden="true">image</span>
          </button>
          <template id="item-images-{{ groupIndex }}-{{ loop.index0 }}">
            {% for src in item.images %}
            <img src="{{ src | url }}" alt="{{ item.name }}參考圖片{{ loop.index }}" class="item-image-dialog__photo">
            {% endfor %}
          </template>
          {% endif %}
        </td>
        <td data-label="價格" class="price-table__price-cell">NT$ {{ item.price }}</td>
        <td data-label="單位">{{ item.unit }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</section>
{% endfor %}

<dialog id="item-image-dialog" class="m3-dialog">
  <div class="m3-dialog__form">
    <h2 class="m3-dialog__title" id="item-image-title"></h2>
    <div id="item-image-body" class="item-image-dialog__body"></div>
    <div class="m3-dialog__actions">
      <button type="button" class="btn btn--text" id="item-image-close">關閉</button>
    </div>
  </div>
</dialog>
