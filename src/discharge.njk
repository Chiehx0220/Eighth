---
layout: layouts/base.njk
title: "出院須知"
permalink: /discharge/
---
<h1>出院須知</h1>
<div class="info-cards">
  {% for rule in discharge.discharge_rules %}
  <div class="info-card">
    <span class="info-card__icon material-symbols-outlined" aria-hidden="true">{{ rule.icon }}</span>
    <div class="info-card__body">
      <p class="info-card__title">{{ rule.title }}</p>
      <p class="info-card__desc">{{ rule.desc }}</p>
    </div>
  </div>
  {% endfor %}
</div>

<h2>出院流程</h2>
<ol class="process-stepper">
  {% for step in discharge.discharge_flow %}
  <li class="process-stepper__item">
    <span class="process-stepper__num">{{ loop.index }}</span>
    <div class="process-stepper__body">
      <p class="process-stepper__text">{{ step }}</p>
    </div>
  </li>
  {% endfor %}
</ol>

<h2>診斷證明書申請須知</h2>
<div class="info-cards">
  {% for rule in discharge.certificate_rules %}
  <div class="info-card">
    <span class="info-card__icon material-symbols-outlined" aria-hidden="true">{{ rule.icon }}</span>
    <div class="info-card__body">
      <p class="info-card__title">{{ rule.title }}</p>
      <p class="info-card__desc">{{ rule.desc }}</p>
    </div>
  </div>
  {% endfor %}
</div>
