---
layout: layouts/base.njk
title: "合作廠商"
permalink: /partners/
---
<h1>合作廠商</h1>
<p>以下為與本病房合作之廠商,如有需要可直接聯繫。</p>

{% if partnersI18n.list.length %}
<div class="vendor-grid">
  {% for partner in partnersI18n.list %}
  <div class="info-card vendor-card">
    {% if partner.logo %}
    <img src="{{ partner.logo }}" alt="{{ partner.name }}標誌" class="vendor-card__logo" loading="lazy" decoding="async">
    {% else %}
    <span class="info-card__icon material-symbols-outlined" aria-hidden="true">{{ partner.icon or "storefront" }}</span>
    {% endif %}

    <div class="info-card__body">
      <p class="info-card__title">{{ partner.name }}</p>
      {% if partner.category %}
      <span class="m3-chip vendor-card__category" data-i18n-dynamic
        data-i18n-zh="{{ partner.category }}"
        data-i18n-en="{{ partner.category_en }}"
        data-i18n-id="{{ partner.category_id }}"
        data-i18n-vi="{{ partner.category_vi }}">{{ partner.category }}</span>
      {% endif %}

      {% if partner.note %}
      <p class="info-card__desc vendor-card__note" data-i18n-dynamic
        data-i18n-zh="{{ partner.note }}"
        data-i18n-en="{{ partner.note_en }}"
        data-i18n-id="{{ partner.note_id }}"
        data-i18n-vi="{{ partner.note_vi }}">{{ partner.note }}</p>
      {% endif %}

      {% if partner.address %}
      <p class="vendor-card__address">
        <span class="material-symbols-outlined" aria-hidden="true">location_on</span>
        <span class="vendor-card__address-text">{{ partner.address }}</span>
      </p>
      {% endif %}

      {% if partner.phones.length or partner.email %}
      <div class="vendor-card__actions">
        {% for phone in partner.phones %}
        <div class="vendor-card__phone">
          {% if phone.label %}<span class="vendor-card__phone-label">{{ phone.label }}</span>{% endif %}
          <a href="tel:{{ phone.number }}" class="btn btn--tonal">
            <span class="material-symbols-outlined" aria-hidden="true">call</span>
            {{ phone.number }}
          </a>
        </div>
        {% endfor %}
        {% if partner.email %}
        <a href="mailto:{{ partner.email }}" class="btn btn--outlined">
          <span class="material-symbols-outlined" aria-hidden="true">mail</span>
          {{ partner.email }}
        </a>
        {% endif %}
      </div>
      {% endif %}
    </div>
  </div>
  {% endfor %}
</div>
{% else %}
<p>目前尚無合作廠商資料。</p>
{% endif %}

